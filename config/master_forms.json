{
 "version": "1.0",
 "forms": {
  "form_student": {
   "form_type": "STUDENT",
   "date_key": "result_date",
   "title": "IT Chronicles - Student Achievements Submission Form",
   "description": "Student competitions, hackathons, projects, higher studies and co-curricular achievements. Enter roll numbers only: names and class details are filled in from the college records.",
   "questions": [
    {
     "q": "A. Students",
     "type": "section"
    },
    {
     "q": "Achievement or Participation",
     "type": "choice",
     "req": true,
     "help": "Choose 'Participation only' when the students took part (an event, workshop, competition, activity) without winning or ranking. List every participant's roll number below so it appears in their class record.",
     "choices": [
      "Achievement (won, ranked or awarded)",
      "Participation only"
     ],
     "key": "entry_kind"
    },
    {
     "q": "Participants (one roll number per line)",
     "type": "roster_roll",
     "req": true,
     "help": "One student per line, roll number only, e.g.\n21IT001\n21IT014\nNames are filled in from the college records.",
     "key": "_participants",
     "nl": "author_or_person",
     "tf": "names_only",
     "aliases": [
      "Participants (one per line: ROLLNO - Student Name)"
     ]
    },
    {
     "q": "Lead Student Roll Number",
     "type": "roll",
     "req": true,
     "key": "_lead_roll"
    },
    {
     "q": "Individual or Team Achievement",
     "type": "choice",
     "req": true,
     "choices": [
      "Individual",
      "Team"
     ],
     "key": "is_team"
    },
    {
     "q": "B. Achievement",
     "type": "section"
    },
    {
     "q": "Student Achievement Category",
     "type": "choice",
     "req": true,
     "choices": [
      "Academic Excellence & Ranks",
      "Hackathons & Coding Competitions",
      "Higher Education & Top Placements",
      "Technical Projects & Innovations",
      "Sports, Cultural & Co-Curricular Accomplishments"
     ],
     "key": "category",
     "nl": "category_id"
    },
    {
     "q": "Name of Competition / Award / Project / Event",
     "type": "text",
     "req": true,
     "key": "title",
     "nl": "title"
    },
    {
     "q": "Organizing Institute / Company / Awarding Body",
     "type": "text",
     "req": true,
     "key": "organizer",
     "nl": "organization_or_venue"
    },
    {
     "q": "Achievement Level",
     "type": "choice",
     "req": true,
     "choices": [
      "Department",
      "College",
      "Inter-college",
      "State",
      "National",
      "International"
     ],
     "key": "level"
    },
    {
     "q": "Position / Rank / Prize / Scholarship",
     "type": "text",
     "req": true,
     "help": "e.g. 1st Prize, Runner-up, Scholarship. For participation only, type Participated.",
     "key": "position",
     "nl": "grant_or_prize_amount"
    },
    {
     "q": "Prize / Scholarship Amount in Rupees (numbers only, 0 if none)",
     "type": "number",
     "req": false,
     "key": "prize_amount"
    },
    {
     "q": "Date of Achievement / Result",
     "type": "date",
     "req": true,
     "key": "result_date",
     "nl": "event_date"
    },
    {
     "q": "Event Start Date",
     "type": "date",
     "req": false,
     "key": "event_start"
    },
    {
     "q": "Event End Date",
     "type": "date",
     "req": false,
     "key": "event_end"
    },
    {
     "q": "Achievement Domain",
     "type": "list",
     "req": true,
     "choices": [
      "AI / Machine Learning",
      "Web / App Development",
      "Cyber Security",
      "IoT / Embedded",
      "Cloud / DevOps",
      "Data Science / Analytics",
      "Algorithms / Competitive Coding",
      "Sports",
      "Cultural",
      "Entrepreneurship",
      "Other"
     ],
     "key": "domain"
    },
    {
     "q": "Faculty Mentor / Project Guide",
     "type": "faculty",
     "req": true,
     "key": "mentor_emp_id"
    },
    {
     "q": "C. Details",
     "type": "section"
    },
    {
     "q": "Project Statement / Objective",
     "type": "para",
     "req": false,
     "key": "project_statement"
    },
    {
     "q": "Project Abstract / Achievement Details",
     "type": "para",
     "req": true,
     "key": "abstract",
     "nl": "description"
    },
    {
     "q": "Tools / Technologies / Methods Used",
     "type": "text",
     "req": false,
     "key": "tools_used"
    },
    {
     "q": "Measurable Result or Impact",
     "type": "text",
     "req": false,
     "key": "measurable_impact"
    },
    {
     "q": "Project Demo / Repository / Portfolio URL",
     "type": "url",
     "req": false,
     "key": "demo_url"
    },
    {
     "q": "Learning Outcomes / Skills Demonstrated",
     "type": "para",
     "req": false,
     "key": "learning_outcomes"
    },
    {
     "q": "Has this Work Received Other Awards or Been Reported Previously?",
     "type": "choice",
     "req": false,
     "choices": [
      "Yes",
      "No"
     ],
     "key": "previously_reported"
    },
    {
     "q": "Related Awards / Previous Submission Details (type NA if none)",
     "type": "text",
     "req": false,
     "key": "related_awards"
    },
    {
     "q": "Media, evidence and consent",
     "type": "section"
    },
    {
     "q": "Key Impact Badge / Metric",
     "type": "text",
     "req": false,
     "help": "Short badge for the newsletter (e.g. 1st Prize, Scopus Q1, MoU Signed, 150+ Attendees)",
     "key": "badge_tag",
     "nl": "badge_tag"
    },
    {
     "q": "Photo Link (Google Drive / Cloud URL)",
     "type": "url",
     "req": false,
     "help": "High-resolution photo. Set sharing to 'Anyone with the link can view'.",
     "key": "media_url",
     "nl": "photo_url"
    },
    {
     "q": "Photo Caption & Persons in Image",
     "type": "text",
     "req": false,
     "help": "Names of the people shown, left to right",
     "key": "photo_caption",
     "nl": "photo_caption"
    },
    {
     "q": "Certificate / Proof Link",
     "type": "url",
     "req": false,
     "key": "evidence_url",
     "nl": "evidence_url"
    },
    {
     "q": "Is this a Landmark / Milestone Achievement?",
     "type": "choice",
     "req": true,
     "help": "Nominate for the Spotlight / Hero story card in the newsletter",
     "choices": [
      "No (Standard Entry)",
      "Yes (Nominate for Spotlight Feature)"
     ],
     "key": "is_landmark"
    },
    {
     "q": "Permission to Publish this Submission",
     "type": "choice",
     "req": true,
     "choices": [
      "Yes - may be published in the IT Chronicles newsletter",
      "No - keep for internal records only"
     ],
     "key": "publish_permission"
    },
    {
     "q": "Accuracy and Authorization Confirmation",
     "type": "confirm",
     "req": true,
     "choices": [
      "I confirm the information is accurate and I am authorised to submit it."
     ],
     "key": "authorization_confirmed"
    }
   ],
   "section_id": "sec_student"
  },
