// ---------------------------- CONFIG ----------------------------------------
// Roll-number format as a regular expression (RE2). Default: 6-15 letters/digits.
const ROLL_ID = '[A-Za-z0-9]{6,15}';
// Any person id (employee id, roll number or EXT for outsiders).
const ANY_ID = '[A-Za-z0-9]{2,15}';

// ---------------------------- VALIDATION ------------------------------------
function linesValidation_(idPattern, help, nameOptional) {
  const line = idPattern + (nameOptional ? '(\\s*-\\s*[^\\n]+)?' : '\\s*-\\s*[^\\n]+');
  const re = '^\\s*' + line + '(\\n\\s*' + line + ')*\\s*$';
  return FormApp.createParagraphTextValidation().requireTextMatchesPattern(re).setHelpText(help).build();
}
const V_ROLL = FormApp.createTextValidation().requireTextMatchesPattern('^' + ROLL_ID + '$')
  .setHelpText('Enter your roll number exactly as on your ID card (letters and digits only).').build();
const V_URL = FormApp.createTextValidation().requireTextIsUrl()
  .setHelpText('Enter a full link starting with https://').build();
const V_NUMBER = FormApp.createTextValidation().requireNumberGreaterThanOrEqualTo(0)
  .setHelpText('Numbers only, e.g. 12.5').build();
const V_ROSTER_ROLL = linesValidation_(ROLL_ID, 'One roll number per line, e.g. 21IT001', true);
const V_ROSTER_ANY = linesValidation_(ANY_ID, 'One per line: ID - Name  (outsiders: EXT - Name - Organization)');

/** Academic years offered in the drop-down: last year, this year and next year. */
function placementYears_() {
  const now = new Date();
  const start = now.getMonth() >= 5 ? now.getFullYear() : now.getFullYear() - 1;
  const label = function (y) { return y + "-" + String((y + 1) % 100).padStart(2, "0"); };
  return [label(start - 1), label(start), label(start + 1)];
}

/** IT Department - Student Placement Data Collection Form */
function createPlacementForm() {
  const form = FormApp.create("IT Department - Student Placement Data Collection Form");
  form.setDescription("Collected for the IT Department placement records. Submit one response per offer (if you hold no offer, submit once with the company left blank). Your roll number and class are never shown to other students - only company-level statistics and anonymous experiences are.");
  form.setCollectEmail(true);
  form.setLimitOneResponsePerUser(false);

  form.addSectionHeaderItem().setTitle("A. You");
  form.addTextItem().setTitle("Roll Number").setRequired(true).setValidation(V_ROLL);
  form.addListItem().setTitle("Placement Academic Year").setRequired(true).setChoiceValues(placementYears_());
  form.addMultipleChoiceItem().setTitle("Placement Preference").setRequired(true).setChoiceValues(["Opted In", "Opted Out"]);
  form.addListItem().setTitle("Reason for Opting Out (only if Opted Out)").setRequired(false).setChoiceValues(["Higher studies", "Entrepreneurship", "Family business", "Government exam preparation", "Other"]);
  form.addSectionHeaderItem().setTitle("B. Offer (leave the company blank if you have no offer)");
  form.addTextItem().setTitle("Company Name").setRequired(false);
  form.addListItem().setTitle("Company Sector").setRequired(false).setChoiceValues(["Product", "IT Services", "Core / Engineering", "Startup", "BFSI", "Consulting", "Other"]);
  form.addMultipleChoiceItem().setTitle("Offer Type").setRequired(false).setChoiceValues(["FTE", "Intern", "FTE+Intern", "Intern-Converted FTE"]);
  form.addTextItem().setTitle("Package in LPA (numbers only, for FTE offers)").setRequired(false).setValidation(V_NUMBER);
  form.addTextItem().setTitle("Internship Stipend in Rupees per Month (numbers only)").setRequired(false).setValidation(V_NUMBER);
  form.addTextItem().setTitle("Job Role").setRequired(false);
  form.addTextItem().setTitle("Work Location").setRequired(false);
  form.addMultipleChoiceItem().setTitle("Offer Status").setRequired(false).setChoiceValues(["Accepted", "Declined", "Pending"]);
  form.addMultipleChoiceItem().setTitle("Recruitment Mode").setRequired(false).setChoiceValues(["On-campus", "Off-campus"]);
  form.addDateItem().setTitle("Offer Date").setRequired(false);
  form.addSectionHeaderItem().setTitle("C. Interview experience");
  form.addTextItem().setTitle("Number of Interview Rounds").setRequired(false).setValidation(V_NUMBER);
  form.addParagraphTextItem().setTitle("Round-wise Details").setHelpText("e.g. Online test, Technical 1, Technical 2, HR").setRequired(false);
  form.addMultipleChoiceItem().setTitle("Interview Difficulty").setRequired(false).setChoiceValues(["Easy", "Medium", "Hard"]);
  form.addParagraphTextItem().setTitle("Questions Asked").setRequired(false);
  form.addMultipleChoiceItem().setTitle("Interview Result").setRequired(false).setChoiceValues(["Selected", "Rejected", "Waitlisted"]);
  form.addParagraphTextItem().setTitle("Your Interview Experience").setRequired(false);
  form.addParagraphTextItem().setTitle("Tips for Juniors").setRequired(false);
  form.addSectionHeaderItem().setTitle("D. Internship experience");
  form.addTextItem().setTitle("Internship Duration").setHelpText("e.g. 6 months").setRequired(false);
  form.addMultipleChoiceItem().setTitle("Internship Mode").setRequired(false).setChoiceValues(["Onsite", "Remote", "Hybrid"]);
  form.addTextItem().setTitle("Internship Role").setRequired(false);
  form.addTextItem().setTitle("Technologies Used in Internship").setRequired(false);
  form.addParagraphTextItem().setTitle("Work Summary").setRequired(false);
  form.addParagraphTextItem().setTitle("Key Learnings").setRequired(false);
  form.addMultipleChoiceItem().setTitle("Internship Rating (1 = poor, 5 = excellent)").setRequired(false).setChoiceValues(["1", "2", "3", "4", "5"]);
  form.addParagraphTextItem().setTitle("Your Internship Experience").setRequired(false);
  form.addSectionHeaderItem().setTitle("E. Consent");
  form.addMultipleChoiceItem().setTitle("Consent to Share Experience Anonymously").setHelpText("Your name, roll number and photo are never shown, whatever you choose.").setRequired(true).setChoiceValues(["Yes - share anonymously with juniors", "No - keep private"]);
  form.addCheckboxItem().setTitle("Accuracy Confirmation").setRequired(true).setChoiceValues(["I confirm the information is accurate."]);

  const sheet = SpreadsheetApp.create(form.getTitle() + " (Responses)");
  form.setDestination(FormApp.DestinationType.SPREADSHEET, sheet.getId());
  Logger.log("IT Department - Student Placement Data Collection Form\n  Fill-in link : " + form.getPublishedUrl() + "\n  Edit link    : " + form.getEditUrl() + "\n  Responses    : " + sheet.getUrl() + "\n");
  return form;
}

