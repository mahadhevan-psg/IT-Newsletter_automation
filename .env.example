# Settings for hosting the IT Matrix portal on your own server.
# These are the SAME variables the Render service uses (Render dashboard -> your service -> Environment).
#
#   1. Copy this file to ".env" in the same folder (it is ignored by Git and never copied into the Docker image).
#   2. Fill in the values below. For the two secrets, copy the values from Render if you want sign-ins and the
#      first admin password to stay the same, or make new ones (see the commands in DEPLOY.md / the notes below).
#   3. Start it, either way (both read this same file):
#        Docker:        docker run -d --name it-portal --restart unless-stopped -p 80:10000 -v /srv/it-data:/data --env-file .env it-portal
#        Without Docker, on this computer:   python run_server.py     (it reads ".env" by itself)
#
# Lines starting with # are comments. Do not put quotes around values, and keep each value on one line.

# ---------------------------------------------------------------------------------------------------- the two secrets (required)
# A long random text. It signs the sign-in sessions; if it changes, everyone has to sign in again. Same as Render's MASTER_SECRET.
# Make a new one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
MASTER_SECRET=put-a-long-random-text-here

# The password of the ADMIN login. Only used the FIRST time, when no admin exists yet (an existing database keeps its own admin
# password; after the first sign-in the app makes you set a new one). Same as Render's MASTER_ADMIN_PASSWORD.
# Already have a database and want ADMIN to use this value? Run once:  python reset_admin_password.py
MASTER_ADMIN_PASSWORD=psg

# ---------------------------------------------------------------------------------------------------- Google Sheet sync (optional)
# Only if the sheets are private: the WHOLE contents of the service account's JSON key on ONE line, or the path of the key file
# as the container sees it (for example /data/google-key.json after you copy the file into the data folder).
# Leave it empty if the sheets are shared as "Anyone with the link can view".
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------------------------------- where the data lives
# Docker: leave these three commented out. The image already sets them (/data) and your data folder is mounted there (-v ... :/data).
# Running on your own computer / server WITHOUT Docker ("python run_server.py"): the databases are kept in the project's "database"
# folder unless you point them elsewhere, for example to a folder that is backed up:
# MASTER_DB_PATH=D:\it-data\master_system.db
# NEWSLETTER_DB_PATH=D:\it-data\newsletter_system.db

# ---------------------------------------------------------------------------------------------------- how the app is reached
# The port. Docker: leave it at 10000 (the image's port) and choose the outside port with -p, for example -p 80:10000.
# "python run_server.py" uses this too (8000 if you leave it out). Render sets PORT itself.
PORT=10000

# "python run_server.py" only (ignored by Docker and Render):
#   HOST=127.0.0.1  this computer only (the default)      HOST=0.0.0.0  everyone on the network can open it
#   RELOAD=0        do not restart when a code file changes (use 0 on a server)
# HOST=127.0.0.1
# RELOAD=1

# ---------------------------------------------------------------------------------------------------- never set these on the real service
# DEMO_MODE and DEMO_RESET_HOURS belong only to the separate public demo site. Leave them out here.
